NODE_ENV=production
APP_VERSION=4.5.0
PORT=3000
DATABASE_URL=postgresql://fbs:CHANGE_ME@postgres:5432/fbs
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
CORS_ORIGINS=https://app.futureblueshark.com,https://futureblueshark.com
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
JSON_BODY_LIMIT=2mb
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
TTS_PROVIDER=
VIDEO_STORAGE_PATH=/app/storage/videos
BILLING_PROVIDER=google_play
PUSH_PROVIDER=
AI_PROVIDER=openai
POSTGRES_DB=fbs
POSTGRES_USER=fbs
POSTGRES_PASSWORD=CHANGE_ME

# Video storage (S3-compatible: AWS S3, Cloudflare R2, MinIO, etc.)
VIDEO_STORAGE_PROVIDER=s3-compatible
VIDEO_STORAGE_BUCKET=
VIDEO_STORAGE_PUBLIC_BASE_URL=https://cdn.example.com
VIDEO_STORAGE_REGION=
